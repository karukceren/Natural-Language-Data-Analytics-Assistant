# ==============================================================================
# Uygulama Konfigürasyonu (.env)
# ==============================================================================

# Uygulama Bilgileri
APP_NAME="Dogal Dil Islemeli Akilli Veri Analiz Asistani"
APP_ENV="development"
DEBUG=True

# LLM API Anahtarları
OPENAI_API_KEY="sk-your-openai-api-key-here"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"

# Veritabanı Bağlantı URL'i
# SQLite için: sqlite:///./data/northwind.db
# PostgreSQL için: postgresql+psycopg2://read_only_user:password@localhost:5432/northwind
# MSSQL için: mssql+pymssql://read_only_user:password@localhost:1433/Northwind
DATABASE_URL="sqlite:///./data/northwind.db"

# LLM Parametreleri
DEFAULT_LLM_PROVIDER="openai"
DEFAULT_MODEL_NAME="gpt-4o"
TEMPERATURE=0.0

# Güvenlik ve Çalıştırma Limitleri
SQL_TIMEOUT_SECONDS=10
MAX_ROW_LIMIT=500
MAX_RETRY_ATTEMPTS=3
